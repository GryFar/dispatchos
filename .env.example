###############################################################################
# DispatchOS — environment reference (.env.example)
#
# Copy to `.env` (loaded via dotenv at boot) or set as Fly/VDS secrets.
# Generated from the actual `process.env.*` usages in the code.
#
# Deployment modes — the app is "production-like" (isProdLike) when ANY of:
#     NODE_ENV=production   |   DISPATCHOS_DEPLOYMENT_MODE=vds   |   FLY_APP_NAME set
#   In prod-like mode the session-secret boot gate is enforced (see below) and
#   security headers (HSTS/COOP) + the locked first-run bootstrap turn on.
#
# Integration secrets (FMCSA / Stripe / Resend / Twilio / Telegram) can ALSO be
# set from the in-app Admin → Integrations UI, which is stored encrypted in the
# DB and OVERRIDES the matching env var. Env values below act as the fallback.
###############################################################################

# =============================================================================
# 1. REQUIRED in production (boot fails or security is broken without these)
# =============================================================================

# Session signing secret. BOOT GATE: in prod-like mode the server refuses to
# start unless this is set, >= 32 chars, and not a known placeholder.
# Generate: openssl rand -hex 32
DISPATCHOS_SESSION_SECRET=
# (Deprecated: the bare SESSION_SECRET is only a last-resort fallback for one
#  legacy HMAC and is NOT boot-gated. Always use DISPATCHOS_SESSION_SECRET.)

# Public base URL of the deployment, e.g. https://app.yourdomain.com .
# Used for signup/invite links, cookie scoping, and the first-run bootstrap
# lock. Set this in every real deploy.
DISPATCHOS_PUBLIC_URL=

# One-time bootstrap token for creating the FIRST admin (M4 lock). In prod-like
# mode POST /api/auth/bootstrap requires header X-Bootstrap-Token == this value.
# Procedure: set it -> create the admin -> UNSET it. Leave blank otherwise.
# Generate: openssl rand -hex 24
DISPATCHOS_BOOTSTRAP_TOKEN=

# AES-256-GCM keyring primary key — base64 of EXACTLY 32 random bytes. Required
# to store credentialed integrations / load sources (the app boots without it,
# but credential-bearing features return 503 until it's set).
# Generate: openssl rand -base64 32
DISPATCHOS_KEYRING_PRIMARY=

# Optional second keyring slot, used ONLY to decrypt older rows during key
# rotation. Set during rotation, then unset after re-encrypting. Same format.
DISPATCHOS_KEYRING_SECONDARY=

# =============================================================================
# 2. Deployment mode / networking
# =============================================================================

# "production" enables prod security (HSTS, secure cookies, bootstrap lock).
NODE_ENV=production
# Set to "vds" for the Windows/bare-VDS deploy path (enables trust proxy).
DISPATCHOS_DEPLOYMENT_MODE=
# Set automatically on Fly.io; presence alone marks the app prod-like.
# FLY_APP_NAME=
PORT=5000
DISPATCHOS_HOST=127.0.0.1
# Express "trust proxy" hop count when behind a reverse proxy (vds mode). Default 1.
DISPATCHOS_TRUST_PROXY=1
# Force-disable Secure cookie flag (ONLY for local http testing). Leave unset in prod.
DISPATCHOS_COOKIE_SECURE=

# =============================================================================
# 3. Payments — Stripe (subscription billing)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-tier Stripe price IDs (resolved by plan tier; see server/lib/plans.ts).
STRIPE_PRICE_TRIAL=
STRIPE_PRICE_OO_BASIC=
STRIPE_PRICE_OO_PREMIUM=
STRIPE_PRICE_FLEET_STARTER=
STRIPE_PRICE_FLEET_GROWTH=
STRIPE_PRICE_FLEET_SCALE=
STRIPE_PRICE_ENTERPRISE=

# =============================================================================
# 4. Email — Resend (invites, alerts, transactional)
# =============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Verifies inbound Resend webhooks (fail-closed if set; events rejected without it).
RESEND_WEBHOOK_SECRET=

# =============================================================================
# 5. SMS / phone 2FA — Twilio Verify
# =============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# =============================================================================
# 6. FMCSA carrier lookup (broker/carrier vetting, double-brokering checks)
# =============================================================================
FMCSA_API_URL=
# NOTE: the app reads FMCSA_WEB_KEY (with underscore). The old FMCSA_WEBKEY
# name is NOT picked up by carrier-safety-profile, silently disabling vetting.
FMCSA_WEB_KEY=

# =============================================================================
# 7. Telegram bots (team alerts + driver portal bot)
# =============================================================================
# Main/team bot token.
TELEGRAM_BOT_TOKEN=
# Driver-facing production bot token (separate bot).
TELEGRAM_DRIVER_BOT_TOKEN=
# Chat id that receives compliance / trial / inbound alerts.
TELEGRAM_ALERT_CHAT_ID=

# =============================================================================
# 8. AI (Claude) — dispatch advisor + driver receipt OCR
# =============================================================================
# Without it, AI suggestions and receipt OCR degrade gracefully (no crash).
ANTHROPIC_API_KEY=

# =============================================================================
# 9. Maps / OAuth (optional integrations)
# =============================================================================
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# =============================================================================
# 10. Webhook / cron shared secrets
# =============================================================================
# Required to call the scheduled-job endpoints: header X-Cron-Secret must match.
DISPATCHOS_CRON_SECRET=
# Verifies inbound email worker -> POST /api/inbound/email (load-source forwarding).
DISPATCHOS_INBOUND_SECRET=

# =============================================================================
# 11. Monitoring — Sentry
# =============================================================================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Shown as the release tag in Sentry.
DISPATCHOS_RELEASE=

# =============================================================================
# 12. Storage paths (have safe defaults)
# =============================================================================
# SQLite file. Default: dispatchos-unified.db
DISPATCHOS_DB_PATH=
# Uploads / data root. Default: dispatchos_data
DISPATCHOS_DATA_ROOT=

# =============================================================================
# 13. Tuning / limits (optional — sensible defaults in code)
# =============================================================================
# Kill-switches (on/off, default on). Set to "off" to disable a limiter.
DISPATCHOS_RATE_LIMIT=on
DISPATCHOS_AUTH_RATE_LIMIT=on
# Global request rate limit per minute (default 240).
DISPATCHOS_RATE_LIMIT_PER_MINUTE=240
# Comma-separated IPs exempt from the rate limiter.
DISPATCHOS_RATE_LIMIT_TRUSTED_IPS=
# Auth-endpoint rate limit per 15 min window (keyed on IP+email).
DISPATCHOS_AUTH_RATE_LIMIT_PER_15MIN=
# Secondary IP-ONLY auth limit per 15 min — stops password-spray across many
# emails from one IP. Default 100 (generous enough not to lock an office NAT).
DISPATCHOS_AUTH_RATE_LIMIT_IP_PER_15MIN=
DISPATCHOS_JSON_LIMIT=1mb
DISPATCHOS_FORM_LIMIT=1mb
DISPATCHOS_UPLOAD_MAX_MB=10
DISPATCHOS_CSV_MAX_ROWS=
# Fallback owner email for alerts when not set via the Integrations UI.
# (insurance-monitor reads DISPATCHOS_OWNER_EMAIL; compliance/trial alerts read
# the unprefixed OWNER_EMAIL — set both to be safe, or configure in the UI.)
DISPATCHOS_OWNER_EMAIL=
OWNER_EMAIL=

# =============================================================================
# Matching / alerts / load-source tunables (all OPTIONAL — sensible defaults)
# =============================================================================
# Per-source inbound email domain for the self-serve free email load source.
# Creating an email source auto-assigns loads+<token>@<this domain>; point a
# Cloudflare Email catch-all on it at POST /api/inbound/email. Default
# inbound.dispatchos.co.
DISPATCHOS_INBOUND_DOMAIN=
# Minimum dispatchScore (0..135) to push a matched load to Telegram. Default 70.
LOAD_ALERT_MIN_SCORE=
# Hours of lead time before pickup to remind the assigned driver. Default 3.
DISPATCHOS_PICKUP_REMINDER_LEAD_HOURS=
# Weight (0..0.4) of the destination outbound-market (backhaul) factor in the
# dispatch score. Default 0 = informational only (shown, not ranked).
DISPATCHOS_BACKHAUL_WEIGHT=
# Weight (0..2) of REAL observed lane rates (lane_history) refining lane quality.
# Default 1; cold-start safe (no effect until a lane has 10+ observations).
DISPATCHOS_LANE_OBSERVED_WEIGHT=

# =============================================================================
# DANGER — do NOT set in production
# =============================================================================
# Legacy health-check flag only (reports auth "ok" when "true"); it does NOT
# bypass real authentication, but leave it UNSET to avoid confusion.
# DISPATCHOS_AUTH_DISABLED=
